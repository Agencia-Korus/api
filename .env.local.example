# ==============================================================================
# .env.local.example — DEV LOCAL (task run / docker compose)
# A conta de serviço do Google Calendar é lida do arquivo
# .env.google-calendar-service-account.json na raiz (gitignorado).
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de dados
# ------------------------------------------------------------------------------
POSTGRES_DB='korus'
POSTGRES_USER='korus'
POSTGRES_PASSWORD='change-me'
DATABASE_URL='postgresql+asyncpg://korus:change-me@korus-db:5432/korus'

# ------------------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------------------
DEBUG=true
CORS_ALLOW_ORIGINS='*'

# ------------------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------------------
JWT_SECRET_KEY='dev-secret-key'
JWT_ALGORITHM='HS256'
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Supabase (upload de imagens)
# ------------------------------------------------------------------------------
SUPABASE_URL=''
SUPABASE_BUCKET='korus-assets'
SUPABASE_SERVICE_ROLE_KEY=''

# ------------------------------------------------------------------------------
# Google Calendar
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_ID=''
GOOGLE_CALENDAR_DELEGATED_USER=''
GOOGLE_CALENDAR_TIMEZONE='America/Sao_Paulo'
GOOGLE_CALENDAR_DAYS_PAST=7
GOOGLE_CALENDAR_DAYS_FUTURE=60

# Em dev, deixe o JSON vazio e coloque o arquivo de credencial na raiz do projeto:
#   .env.google-calendar-service-account.json   (já está no .gitignore)
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=''
GOOGLE_CALENDAR_SERVICE_ACCOUNT_FILE=/run/secrets/google-calendar-service-account.json
GOOGLE_CALENDAR_SERVICE_ACCOUNT_HOST_FILE=.env.google-calendar-service-account.json
